    "@vanilla-extract/dynamic": "npm:@vanilla-extract/dynamic@^2.1.5",
    "@vanilla-extract/recipes": "npm:@vanilla-extract/recipes@^0.5.7",
    "clsx": "npm:clsx@^2.1.1",
    "csstype": "npm:csstype@^3.2.3",
