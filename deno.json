{
  "workspace": ["./docs", "./styles", "./tools", "./tailwind-plugin"],
  "nodeModulesDir": "auto",
  "tasks": {
    "deps:outdated": "deno outdated",
    "deps:update": "deno outdated --update --latest --interactive",
    "check": "deno fmt --check . && deno check . && deno lint ."
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom"
    ]
  },
  "fmt": {
    "exclude": ["docs/.vite", "docs/dist"]
  },
  "lint": {
    "exclude": ["styles/transformed", "docs/.vite", "docs/dist"],
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
