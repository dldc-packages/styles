{
  "name": "@dldc-sandbox/styles",
  "version": "0.4.0",
  "exports": "./transformed/mod.ts",
  "nodeModulesDir": "auto",
  "tasks": {
    "transform": "deno run -A transform.ts"
  },
  "imports": {
    "@dldc/css-builder": "jsr:@dldc/css-builder@^1.6.0",
    "@jsr/deno__loader": "npm:@jsr/deno__loader@^0.5.0",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@vanilla-extract/css": "npm:@vanilla-extract/css@^1.21.2",
    "@vanilla-extract/css-utils": "npm:@vanilla-extract/css-utils@^0.1.6",
    "@vanilla-extract/dynamic": "npm:@vanilla-extract/dynamic@^2.1.5",
    "@vanilla-extract/integration": "npm:@vanilla-extract/integration@^8.0.10",
    "@vanilla-extract/recipes": "npm:@vanilla-extract/recipes@^0.5.7",
    "clsx": "npm:clsx@^2.1.1",
    "csstype": "npm:csstype@^3.2.3",
    "esbuild": "npm:esbuild@^0.28.2",
    "type-fest": "npm:type-fest@^5.9.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom"
    ]
  },
  "lint": {
    "exclude": ["transformed"],
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "publish": {
    "include": ["transformed", "src"]
  }
}
